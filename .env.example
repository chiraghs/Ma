# ==============================================================================
# MA Environment Configuration
# ==============================================================================

# Model Context Protocol (MCP) Server Endpoint
# Default local Streamable HTTP endpoint
MCP_SERVER_URL=http://127.0.0.1:8005/mcp

# FastMCP / API Server Host and Ports
MCP_PORT=8005
AGENT_PORT=8001

# Amazon Bedrock Credentials (Optional for local test runs; agent falls back automatically)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=your_optional_session_token_here

# Bedrock Model ID
# Options: anthropic.claude-3-5-sonnet-20241022-v2:0, amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Mother's profile configuration
DEFAULT_MOTHER_NAME=Sarah
DEFAULT_BABY_NAME=Maya
